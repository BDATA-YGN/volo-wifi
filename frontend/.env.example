# =============================================================================
# Frontend env — set each concern ONCE (NEXT_PUBLIC_* auto-mirrored at build)
# See env/apply-defaults.mjs
# =============================================================================

# --- Required (local) ---
API_URL=http://localhost:4458/console
CAPTIVE_API_URL=http://localhost:4457/api
SOCKET_URL=http://localhost:4459
SOCKET_PATH=/general/socket.io
CACHE_PREFIX=volo-wifi
BY_PASS=false

# Optional — only if you still use direct CDN path rewrites (/images, /icons, …).
# Not required when files are served via backend MinIO/S3 (API_URL / file-proxy).
# FILE_SERVER_URL=https://cdn.example.com/public
# HOST_NAME=localhost

# --- Optional hosts (Dokploy / multi-domain) ---
# CAPTIVE_HOST=captive.volowifi.com
# PARTNER_HOST=partner.volowifi.com
# COLLECTOR_HOST=collector.volowifi.com
# CUSTOMER_HOST=customer.volowifi.com

# =============================================================================
# Production (Dokploy) — set BEFORE build
# =============================================================================
# NODE_ENV=production
# TZ=Asia/Yangon
# PORT=4488
# HOSTNAME=0.0.0.0
#
# API_URL=https://console.volowifi.com/console
# CAPTIVE_API_URL=https://api.volowifi.com/api
# SOCKET_URL=https://socket.volowifi.com
# SOCKET_PATH=/general/socket.io
# CACHE_PREFIX=volo-wifi
# BY_PASS=false
# CAPTIVE_HOST=captive.volowifi.com
# PARTNER_HOST=partner.volowifi.com
# COLLECTOR_HOST=collector.volowifi.com
# CUSTOMER_HOST=customer.volowifi.com
# Optional legacy CDN only (skip with MinIO/S3 via API):
# FILE_SERVER_URL=https://cdn.volowifi.com/public
# HOST_NAME=console.volowifi.com
#
# You do NOT need NEXT_PUBLIC_API_URL / NEXT_PUBLIC_SOCKET_URL / etc.
# They are filled from the keys above.

# =============================================================================
# Dokploy notes
# =============================================================================
# Root Directory: frontend
# Install: npm ci | Build: npm run build | Start: npm start
# Health: GET /health | Port: 4488
# NIXPACKS_NODE_VERSION=22
