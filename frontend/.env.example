# API_URL=http://localhost:6558/console
# HOST_NAME=localhost:3000
# FILE_SERVER_URL=https://loop.megamusic.app/mega-prod-public
# BY_PASS=false
# NODE_ENV=development
# NEXT_PUBLIC_NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:6558/console
# NEXT_PUBLIC_SOCKET_URL=http://localhost:6559
# NEXT_PUBLIC_SOCKET_PATH="/general/socket.io"
# NEXTJS_PORT=3088
# NEXTJS_CONTAINER_NAME=bdata-core-console
# Unique per app when several consoles share localhost (avoids menu localStorage collisions)
# NEXT_PUBLIC_CACHE_PREFIX=bdata-admin
#
# Mobile subdomains — canonical URLs only (/collector/*, /customer/*); root / redirects:
# CUSTOMER_HOST=customer.volowifi.com
# COLLECTOR_HOST=collector.volowifi.com
# CAPTIVE_HOST=captive.volowifi.com
# PARTNER_HOST=partner.volowifi.com
# NEXT_PUBLIC_PARTNER_HOST=partner.volowifi.com
#
# Captive portal API (backend /api app — default derived from API_URL by swapping /console → /api)
# CAPTIVE_API_URL=http://localhost:4457/api
# NEXT_PUBLIC_CAPTIVE_API_URL=/portal-api
#
# PWA: manifests at /collector/manifest.webmanifest and /customer/manifest.webmanifest
# Service workers at /collector/sw.js and /customer/sw.js (requires HTTPS in production)

# =============================================================================
# Deploy only (Dokploy / Railpack — not read by Next.js at runtime unless NEXT_PUBLIC_*)
# =============================================================================
# REQUIRED — monorepo (volo-sms has no package.json at repo root):
#   Dokploy → Application → General → Root Directory: frontend
#   Without this, build fails: ENOENT /app/package.json
#
# Build type: Railpack
#
# Use npm (no yarn.lock). Remove wrong vars if copied from backend:
#   RAILPACK_INSTALL_CMD=yarn install --force   ← delete this
# Or set explicitly:
#   RAILPACK_INSTALL_CMD=npm install
#   RAILPACK_BUILD_CMD=npm run build
#   RAILPACK_START_CMD=npm start
#
# Set NEXT_PUBLIC_* in Dokploy env before build (production API/socket URLs).