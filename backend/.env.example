# =============================================================================
# Server
# =============================================================================
NODE_ENV=development
TZ=UTC
PORT=6558
API_PORT=6557
SOCKET_PORT=6559

# =============================================================================
# Database (Prisma uses DATABASE_URL; DB_* used by pg tools & database feature)
# =============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/isp_hub?options=-c%20timezone=UTC"
# Managed Postgres SSL (DigitalOcean / production). Leave unset for local Postgres without SSL.
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=ssl/ca-certificate-volo-private.crt
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=isp_hub
DB_USER=postgres
DB_PASSWORD=password
DB_LOG=false
# Managed Postgres SSL (required for DigitalOcean / remote DATABASE_URL).
# pg backup/restore tools read DATABASE_URL + these vars via applyPgSslEnv().
# Relative paths resolve from backend/; production containers may use /app/ssl/...
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=ssl/ca-certificate-volo-private.crt

# =============================================================================
# Security & API
# =============================================================================
SECRET_KEY=change-me-in-production
DEFAULT_PAGINATION_LIMIT=10
# Comma-separated; must match your Next.js origin (e.g. http://localhost:4488)
ALLOWED_ORIGINS=http://localhost:4488

# =============================================================================
# Logging
# =============================================================================
LOG_FORMAT=dev
LOG_LEVEL=info
LOG_DIR=./storages/logs

# =============================================================================
# Local paths
# =============================================================================
DB_BACKUP=./storages/backups
# Local Postgres in Docker (version mismatch with host pg_dump):
# PG_DOCKER_CONTAINER=postgres18
# Remote managed Postgres (DigitalOcean): backup/restore uses DATABASE_URL + SSL and
# runs pg_dump/psql from this image to match server version (default postgres:18):
# PG_CLIENT_DOCKER_IMAGE=postgres:18

# =============================================================================
# File storage
# =============================================================================
# STORAGE_ENABLED=false  → local filesystem (STORAGE_LOCAL_DIR, default ./storages/uploads)
# STORAGE_ENABLED=true   → remote S3-compatible storage (pick STORAGE_PROVIDER below)
#
# --- Shared ---
STORAGE_ENABLED=false
STORAGE_PROVIDER=minio
STORAGE_LOCAL_DIR=./storages/uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BUCKET=public
STORAGE_PRIVATE_BUCKET=private
STORAGE_PUBLIC_BASE_URL=
STORAGE_ENDPOINT=
STORAGE_PORT=0
STORAGE_USE_SSL=false
STORAGE_REGION=auto
#
# --- MinIO (self-hosted) ---
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=127.0.0.1
# STORAGE_PORT=9000
# STORAGE_USE_SSL=false
#
# --- Cloudflare R2 ---
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_REGION=auto
# STORAGE_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
#
# --- DigitalOcean Spaces ---
# STORAGE_PROVIDER=do_spaces
# STORAGE_ENDPOINT=nyc3.digitaloceanspaces.com
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_REGION=nyc3
# STORAGE_PUBLIC_BASE_URL=https://<bucket>.nyc3.cdn.digitaloceanspaces.com

# =============================================================================
# Socket.IO Redis (optional)
# =============================================================================
SOCKET_REDIS_ENABLED=true
IO_REDIS_URL=127.0.0.1:6379

# =============================================================================
# Push notifications
# =============================================================================
MOBILE_ENV=development

# =============================================================================
# Optional
# =============================================================================
# TRUST_PROXY=1
# MASTER_PROTECTOR_KEY=
# REDIRECT_SECRET_KEY=

# =============================================================================
# Deploy only (Dokploy / Nixpacks — not read by application code at runtime)
# =============================================================================
# Set in Dokploy Environment tab (or rely on backend/.nvmrc + nixpacks.toml):
# NIXPACKS_NODE_VERSION=22
#
# Dokploy app settings (monorepo):
#   Root directory: backend
#   Build command:  npm run build   (default)
#   Start command:  npm start       (default)
#
# RAILPACK_* below are legacy Railpack hints only:
# RAILPACK_INSTALL_CMD=npm install --force
# RAILPACK_BUILD_CMD=npm run build
# RAILPACK_START_CMD=npm start
