# =============================================================================
# Production (Dokploy) — copy to Environment tab
# =============================================================================
# NODE_ENV=production
# TZ=UTC
# TRUST_PROXY=1
#
# Three HTTP listeners in one container — map each domain in Dokploy to a port:
#   console.volowifi.com  → PORT      (admin API + WiFi console)
#   api.volowifi.com      → API_PORT  (captive portal /api)
#   socket.volowifi.com   → SOCKET_PORT (Socket.IO)
#
# PORT=6558
# API_PORT=6557
# SOCKET_PORT=6559
#
# DATABASE_URL=postgresql://user:pass@host:5432/volo_wifi_db?options=-c%20timezone=UTC
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=ssl/ca-certificate-volo-private.crt
#
# SECRET_KEY=<long-random-string>
# ALLOWED_ORIGINS=https://console.volowifi.com,https://captive.volowifi.com,https://partner.volowifi.com,https://collector.volowifi.com,https://customer.volowifi.com
#
# SOCKET_REDIS_ENABLED=false
# IO_REDIS_URL=redis:6379
#
# STORAGE_ENABLED=true
# STORAGE_PROVIDER=do_spaces
# STORAGE_ENDPOINT=nyc3.digitaloceanspaces.com
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BUCKET=public
# STORAGE_PRIVATE_BUCKET=private
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
#
# MOBILE_ENV=production
# Mount Firebase JSON at runtime (not in git):
#   src/third-party/bdataFirebaseFCM/production.json

# =============================================================================
# Deploy only (Dokploy / Nixpacks — not read by application code at runtime)
# =============================================================================
# Dokploy app settings (monorepo):
#   Root directory: backend
#   Build: Nixpacks (nixpacks.toml) or Dockerfile
#   Install: npm ci
#   Build:   npm run build
#   Start:   npm start
#   Health:  GET /console/health on PORT
#
# After first deploy, run migrations once (Dokploy one-off / SSH):
#   npx prisma migrate deploy
#
# NIXPACKS_NODE_VERSION=22
