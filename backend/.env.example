# =============================================================================
# Backend env template — copy values into Dokploy Environment or local .env
# One source of truth per concern (no duplicated DB_* / MOBILE_ENV / ORIGIN).
# =============================================================================

# --- Server ---
# NODE_ENV=production
# TZ=Asia/Yangon
# TRUST_PROXY=1
# PORT=6558          # console API
# API_PORT=6557      # captive /api
# SOCKET_PORT=6559   # Socket.IO

# --- Database (single URL; SSL only for managed/remote) ---
# Prisma DateTime = timestamptz (absolute). Backend pools force session UTC because
# @prisma/adapter-pg mis-reads timestamptz when session TZ is Asia/Yangon (prisma#26786).
# UI/calendar still Asia/Yangon via TZ=Asia/Yangon + app-time + frontend dayjs.
# DATABASE_URL=postgresql://user:pass@host:25060/volo_wifi_db?options=-c%20timezone%3DUTC
# Direct port 25060. Keep this for Prisma migrate. Do not point it at a connection pool.
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=ssl/ca-certificate-volo-private.crt
#
# DigitalOcean connection pool for the running API (create in the cluster UI first):
#   Name: volo-wifi-app
#   Database: volo_wifi_db
#   User: doadmin
#   Mode: session
#   Size: 24
#   Port: 25061  (database name in the URI is the pool name, not volo_wifi_db)
# Session mode is required. Transaction mode resets TimeZone to Asia/Yangon and
# breaks Prisma timestamptz. One API process opens two pools (Prisma + raw SQL),
# each up to DATABASE_POOL_MAX, so size 24 covers one instance plus a deploy overlap.
# DATABASE_POOL_URL=postgresql://user:pass@host:25061/volo-wifi-app?sslmode=require
#
# Optional pool tuning (defaults are fine until the DO pool above exists):
# DATABASE_POOL_MAX=8
# DATABASE_POOL_IDLE_MS=20000
# DATABASE_POOL_CONNECT_MS=30000
# DATABASE_APPLICATION_NAME=volo-wifi-backend
# DB_LOG=false
# DB_BACKUP=./storages/backups
#
# --- Legacy WiFi DB migration (volo-api-console → volo-wifi) ---
# OLD_DATABASE_URL=postgresql://user:pass@host:5432/volo_db?options=-c%20timezone%3DUTC
# OLD_DATABASE_SSL_MODE=require
# yarn data:wifi:migrate:dry
# yarn data:wifi:migrate -- --apply --i-understand

# --- Security & CORS ---
# SECRET_KEY=<long-random-string>
# DEFAULT_PAGINATION_LIMIT=10
# ALLOWED_ORIGINS=https://console.volowifi.com,https://captive.volowifi.com,https://partner.volowifi.com,https://collector.volowifi.com,https://customer.volowifi.com
# Never treat these public hops as the Wi‑Fi client device IP (NAS wlanuserip / Framed-IP only).
# CAPTIVE_IGNORE_CLIENT_IPS=159.223.63.109

# --- Logging ---
# LOG_FORMAT=combined
# LOG_LEVEL=info
# LOG_DIR=./storages/logs

# --- Socket Redis ---
# Leave false on single-instance Dokploy (no Redis required).
# SOCKET_REDIS_ENABLED=false
# IO_REDIS_URL=redis:6379

# --- Storage ---
# STORAGE_ENABLED=true
# STORAGE_PROVIDER=do_spaces
# STORAGE_BUCKET=public-or-shared-name
# STORAGE_PUBLIC_BUCKET=   # optional override (defaults to STORAGE_BUCKET)
# STORAGE_PRIVATE_BUCKET=  # optional override (defaults to STORAGE_BUCKET)
# STORAGE_ENDPOINT=nyc3.digitaloceanspaces.com
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_REGION=nyc3
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# STORAGE_LOCAL_DIR=./storages/uploads

# --- Firebase (optional push) ---
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase.json

# =============================================================================
# --- Captive portal login rate limits ---
# Same-IP limiter keys on NAS client IP only (ip / wlanuserip). When unset, App Setting
# `captive_login_ip_rate_limit_enabled` applies (default on). Env overrides when set.
# CAPTIVE_LOGIN_IP_RATE_LIMIT_ENABLED=true
# CAPTIVE_LOGIN_IP_MAX=30
# CAPTIVE_LOGIN_IP_WINDOW_MS=900000
# CAPTIVE_LOGIN_CREDENTIAL_MAX=8
# CAPTIVE_LOGIN_CREDENTIAL_WINDOW_MS=900000

# Dokploy notes (not app runtime vars)
#   Root directory: backend | Build: Dockerfile or Nixpacks | Start: npm start
#   Health: GET /console/health on PORT
#   After first deploy: npx prisma migrate deploy
#   NIXPACKS_NODE_VERSION=22
# =============================================================================
