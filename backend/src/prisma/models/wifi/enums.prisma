// WiFi domain enums (portable Prisma enums; validate codes in app when adding providers).
enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum StationStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum DeviceType {
  ROUTER
  AP
  CONTROLLER
  SWITCH
}

enum CredentialType {
  VOUCHER_TOKEN // token only
  USER_PASSWORD // username & password
}

enum CredentialStatus {
  /// Issued / sold, not yet used for captive or RADIUS login.
  SOLD
  /// First successful login completed; package is in use.
  ACTIVATED
  /// Quota fully used (time and/or data).
  CONSUMED
  /// Temporarily locked (e.g. single-session plan awaiting reseller unlock).
  PAUSED
  /// Manually revoked; cannot login.
  REVOKED
  /// Past expiresAt or marked expired by jobs.
  EXPIRED
}

enum PlanQuotaType {
  TIME_ONLY
  DATA_ONLY
  TIME_AND_DATA
}

enum PlanTimeUsageMode {
  CUMULATIVE_SESSIONS
  SINGLE_SESSION
}

enum UnitTime {
  MINUTE
  HOUR
  DAY
  MONTH
}

enum SaleStatus {
  DRAFT
  PAID
  VOID
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum RptFinSettlementStatus {
  /// System computed totals are available, but not yet approved for reporting
  DRAFT
  /// Reseller submitted declared cash totals (may differ from system)
  DECLARED
  /// Station role attested (step 1)
  STATION_ATTESTED
  /// Organization role approved (step 2 / final)
  ORG_APPROVED
  REJECTED
  /// Immutable financial snapshot created for reporting
  POSTED
}

enum RptFinAttestationKind {
  STATION
  ORGANIZATION
}

enum RptFinPostingKind {
  /// Sealed totals for UI/reporting (derived, immutable)
  SETTLEMENT_SNAPSHOT
}

enum RadiusAcctStatus {
  START
  INTERIM
  STOP
}

enum CommissionType {
  FIXED
  PERCENT
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum OrgLicenseStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PricingSource {
  GLOBAL_DEFAULT
  ORG_CUSTOM
  MANUAL_OVERRIDE
}

enum LicenseChangeType {
  STATION_LIMIT_CHANGE
  STATION_SIZE_PRICE_CHANGE
  PRICE_CHANGE
  STATUS_CHANGE
  OTHER
}

/// Where Access Tokens sold under sites of this capacity tier may log in (captive).
enum StationTokenUsageScope {
  SITE
  TIER
  ALL
}
