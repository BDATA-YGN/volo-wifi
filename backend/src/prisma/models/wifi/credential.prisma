// Vouchers, credentials, captive portal sessions.
model Credential {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  type   CredentialType @map("type")   @default(VOUCHER_TOKEN)
  status CredentialStatus @map("status") @default(SOLD)

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  // Token or login credentials
  token        String? @map("token") @unique
  username     String? @map("username")
  passwordHash String? @map("password_hash")

  // Optional binding to station / reseller
  stationId String? @map("station_id")
  station   WifiStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  resellerId String? @map("reseller_id")
  reseller   Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)

  voucherBatchId String? @map("voucher_batch_id")
  voucherBatch   VoucherBatch? @relation(fields: [voucherBatchId], references: [id], onDelete: SetNull)

  // Lifecycle
  soldAt      DateTime? @db.Timestamptz(3) @map("sold_at")
  activatedAt DateTime? @db.Timestamptz(3) @map("activated_at")
  expiresAt   DateTime? @db.Timestamptz(3) @map("expires_at")
  revokedAt   DateTime? @db.Timestamptz(3) @map("revoked_at")

  /// When set, only RADIUS sessions with stoppedAt strictly after this time count toward SINGLE_SESSION blocking.
  singleSessionResellerUnlockAt DateTime? @db.Timestamptz(3) @map("single_session_reseller_unlock_at")

  // For data/time tracking
  timeRemainingSec Int? // optional if you want remaining cache @map("time_remaining_sec")
  dataRemainingMb  Int? @map("data_remaining_mb")

  salesItems SaleItem[]
  sessions   RadiusSession[]
  captivePortalSessions CaptivePortalSession[]

  createdAt DateTime @db.Timestamptz(3) @map("created_at")  @default(now())
  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")  @updatedAt
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@index([orgId, type, status], map: "idx_wf_credential__org_id__type__status")
  @@index([orgId, planId], map: "idx_wf_credential__org_id__plan_id")
  @@index([orgId, soldAt], map: "idx_wf_credential__org_id__sold_at")
  @@index([orgId, activatedAt], map: "idx_wf_credential__org_id__activated_at")
  @@index([orgId, expiresAt], map: "idx_wf_credential__org_id__expires_at")
  @@index([orgId, revokedAt], map: "idx_wf_credential__org_id__revoked_at")
  @@index([orgId, stationId], map: "idx_wf_credential__org_id__station_id")
  @@index([orgId, resellerId], map: "idx_wf_credential__org_id__reseller_id")
  @@index([username], map: "idx_wf_credential__username")
  @@index([username, status], map: "idx_wf_credential__username__status")
  @@index([token, status], map: "idx_wf_credential__token__status")
  /// CredentialRadiusSyncCronService: deletedAt + status filter, orderBy updatedAt
  @@index([deletedAt, status, updatedAt], map: "idx_wf_credential__deleted_at__status__updated_at")
  @@index([stationId, status], map: "idx_wf_credential__station_id__status")
  @@index([voucherBatchId], map: "idx_wf_credential__voucher_batch_id")
  @@map("wf_credential")
}

model CaptivePortalSession {
  id           String @map("id")   @id @default(uuid())
  orgId        String @map("org_id")
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  credentialId String @map("credential_id")
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  username     String   @map("username") // username or token for display / lookup
  ip           String?  @map("ip") // client IP at portal login
  mac          String?  @map("mac") // client MAC (Calling-Station-Id)
  nasParams    Json     @map("nasParams") // login_url, logout_url, nas_ip, uamport, etc. from NAS redirect
  createdAt    DateTime @db.Timestamptz(3) @map("created_at") @default(now())
  updatedAt    DateTime @db.Timestamptz(3) @map("updated_at") @updatedAt

  @@index([orgId, username], map: "idx_wf_captive_portal_session__org_id__username")
  @@index([credentialId, createdAt], map: "idx_wf_captive_portal_session__credential_id__created_at")
  @@index([orgId, ip], map: "idx_wf_captive_portal_session__org_id__ip")
  @@map("wf_captive_portal_session")
}

/// Cold storage for terminal WiFi credentials removed from the hot table.
model CredentialArchive {
  id       String @map("id") @id @default(uuid())
  sourceId String @map("source_id") @unique

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  type   CredentialType @map("type")
  status CredentialStatus @map("status")

  planId     String  @map("plan_id")
  stationId  String? @map("station_id")
  resellerId String? @map("reseller_id")

  token        String? @map("token")
  username     String? @map("username")
  passwordHash String? @map("password_hash")

  soldAt      DateTime? @db.Timestamptz(3) @map("sold_at")
  activatedAt DateTime? @db.Timestamptz(3) @map("activated_at")
  expiresAt   DateTime? @db.Timestamptz(3) @map("expires_at")
  revokedAt   DateTime? @db.Timestamptz(3) @map("revoked_at")

  timeRemainingSec Int? @map("time_remaining_sec")
  dataRemainingMb  Int? @map("data_remaining_mb")

  sourceCreatedAt DateTime @db.Timestamptz(3) @map("source_created_at")
  sourceUpdatedAt DateTime @db.Timestamptz(3) @map("source_updated_at")
  archiveReason   String?  @map("archive_reason")
  archivedAt      DateTime @db.Timestamptz(3) @map("archived_at") @default(now())

  @@index([orgId, archivedAt], map: "idx_wf_credential_arc__org_id__archived_at")
  @@index([orgId, status, archivedAt], map: "idx_wf_credential_arc__org_id__status__archived_at")
  @@map("wf_credential_archive")
}

model VoucherBatch {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  batchNo String @map("batch_no")
  planId  String @map("plan_id")
  plan    Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  quantity          Int @map("quantity")
  remainingQuantity Int @map("remaining_quantity")
  prefix            String? // manually add but unique check @map("prefix")
  note              String? @map("note")

  // (optional) default assignment
  stationId  String? @map("station_id")
  station    WifiStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  resellerId String? @map("reseller_id")
  reseller   Reseller?    @relation(fields: [resellerId], references: [id], onDelete: SetNull)

  /// Admin who generated this voucher run (null for legacy / migrated batches).
  createdByAdminId String? @map("created_by_admin_id")
  createdByAdmin   Admin?  @relation("WifiVoucherBatchCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  credentials Credential[]

  createdAt DateTime @db.Timestamptz(3) @map("created_at")  @default(now())
  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")  @updatedAt
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@unique([orgId, batchNo], map: "uq_wf_voucher_batch__org_id__batch_no")
  @@index([orgId, planId], map: "idx_wf_voucher_batch__org_id__plan_id")
  @@index([createdByAdminId], map: "idx_wf_voucher_batch__created_by_admin_id")
  @@map("wf_voucher_batch")
}
