// Plans and price books.
model Plan {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  code        String @map("code")
  name        String @map("name")
  description String? @map("description")
  /// Derived from time/data limits for filters & analytics.
  /// TIME_ONLY = time>0 & data=0; DATA_ONLY = time=0 & data>0; TIME_AND_DATA = both limited or both unlimited.
  quotaType   PlanQuotaType @map("quota_type") @default(TIME_ONLY)

  /// Allow-time amount. 0 = unlimited time. Null is legacy (treat as unlimited when unused).
  timeAmount Int? @map("time_amount")
  timeUnit   UnitTime? @map("time_unit")

  /// Data quota in MB. 0 = unlimited data. Null is legacy (treat as unlimited when unused).
  dataMb Int? @map("data_mb")

  // validity (days) from first activation
  validityDays Int? @map("validity_days") @default(1) //TODO do we need on time based ?

  // concurrency / device limit
  maxDevices Int? @map("max_devices") @default(1)

  /// Applies when allow-time is limited (timeAmount > 0). Ignored when time is unlimited.
  timeUsageMode PlanTimeUsageMode @map("time_usage_mode") @default(CUMULATIVE_SESSIONS)

  isActive Boolean @map("is_active") @default(true)

  prices          PlanPrice[]
  credentials     Credential[]
  voucherBatches  VoucherBatch[]
  salesItems      SaleItem[]
  commissionRules CommissionRule[]
  planAttributes  PlanRadiusAttribute[]
  dailyStats      DailySalesStat[]
  monthlyStats    MonthlySalesStat[]
  yearlyStats     YearlySalesStat[]
  dailyRadiusUsageStats DailyRadiusUsageStat[]
  resellerEntitlements ResellerPlanEntitlement[]
  stationPlanOffers    StationPlanOffer[]

  createdAt DateTime @db.Timestamptz(3) @map("created_at")  @default(now())
  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")  @updatedAt
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@unique([orgId, code], map: "uq_wf_plan__org_id__code")
  @@index([orgId, quotaType], map: "idx_wf_plan__org_id__quota_type")
  @@index([orgId, isActive], map: "idx_wf_plan__org_id__is_active")
  @@map("wf_plan")
}

model PlanPriceBook {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  name      String @map("name")
  isDefault Boolean @map("is_default") @default(false)

  /// Optional: shared list prices for a capacity tier (SMALL/MEDIUM/LARGE).
  stationSizeId String?      @map("station_size_id")
  stationSize   StationSize? @relation(fields: [stationSizeId], references: [id], onDelete: SetNull)

  prices    PlanPrice[]
  stations  PlanPriceBookStation[]
  resellers PlanPriceBookReseller[]

  createdAt DateTime @db.Timestamptz(3) @map("created_at")  @default(now())
  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")  @updatedAt
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@index([orgId, isDefault], map: "idx_wf_plan_price_book__org_id__is_default")
  @@index([orgId, stationSizeId], map: "idx_wf_plan_price_book__org_id__station_size_id")
  @@map("wf_plan_price_book")
}

/// Many sites can share one station-scoped price book.
model PlanPriceBookStation {
  id          String        @id @default(uuid()) @map("id")
  priceBookId String        @map("price_book_id")
  priceBook   PlanPriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  stationId   String        @map("station_id")
  station     WifiStation   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  createdAt DateTime @db.Timestamptz(3) @map("created_at") @default(now())

  @@unique([priceBookId, stationId], map: "uq_wf_plan_price_book_station__book_station")
  @@index([stationId], map: "idx_wf_plan_price_book_station__station_id")
  @@map("wf_plan_price_book_station")
}

/// Many resellers can share one reseller-scoped price book.
model PlanPriceBookReseller {
  id          String        @id @default(uuid()) @map("id")
  priceBookId String        @map("price_book_id")
  priceBook   PlanPriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  resellerId  String        @map("reseller_id")
  reseller    Reseller      @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  createdAt DateTime @db.Timestamptz(3) @map("created_at") @default(now())

  @@unique([priceBookId, resellerId], map: "uq_wf_plan_price_book_reseller__book_reseller")
  @@index([resellerId], map: "idx_wf_plan_price_book_reseller__reseller_id")
  @@map("wf_plan_price_book_reseller")
}

model PlanPrice {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  priceBookId String @map("price_book_id")
  priceBook   PlanPriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  // Price + cost
  retailPrice Decimal @map("retail_price")  @db.Decimal(18, 2)
  costPrice   Decimal? @map("cost_price") @db.Decimal(18, 2)

  isActive Boolean @map("is_active") @default(true)

  createdAt DateTime @db.Timestamptz(3) @map("created_at")  @default(now())
  updatedAt DateTime @db.Timestamptz(3) @map("updated_at")  @updatedAt
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@unique([priceBookId, planId], map: "uq_wf_plan_price__price_book_id__plan_id")
  @@index([orgId, planId], map: "idx_wf_plan_price__org_id__plan_id")
  @@index([orgId, isActive], map: "idx_wf_plan_price__org_id__is_active")
  @@map("wf_plan_price")
}
