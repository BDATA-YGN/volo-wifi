// Finance-grade settlement, attestation, sealed postings.
model RptFinSettlement {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  resellerId String @map("reseller_id")
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Restrict)

  /// Station context for the cash-collection / verification workflow
  stationId String @map("station_id")
  station   WifiStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  /// Inclusive business period in org timezone, stored as absolute instants (UTC) by convention
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  status RptFinSettlementStatus @map("status") @default(DRAFT)

  /// System computed (from `wf_payment` / `wf_sale_order` rules) at settlement creation time
  systemCurrency String @map("system_currency")   @default("MMK")
  systemTotal    Decimal @map("system_total")  @default(0) @db.Decimal(18, 2)
  systemPaymentsCount Int @map("system_payments_count") @default(0)
  systemOrdersCount   Int @map("system_orders_count") @default(0)

  /// Reseller declared totals (esp. CASH) — can disagree with `systemTotal`
  declaredCurrency String @map("declared_currency")  @default("MMK")
  declaredTotal    Decimal? @map("declared_total") @db.Decimal(18, 2)
  declaredNote     String? @map("declared_note")

  lines  RptFinSettlementLine[]
  events RptFinAttestation[]

  /// Exactly one posting record when status becomes POSTED
  posting RptFinPosting?

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt
  deletedAt DateTime? @map("deleted_at")

  @@unique([orgId, resellerId, stationId, periodStart, periodEnd], map: "uq_rpt_fin_settlement__orgid_reseid_statid_peristar_periend")
  @@index([orgId, status, periodStart], map: "idx_rpt_fin_settlement__org_id__status__period_start")
  @@index([resellerId, status, periodStart], map: "idx_rpt_fin_settlement__reseller_id__status__period_start")
  @@index([stationId, status, periodStart], map: "idx_rpt_fin_settlement__station_id__status__period_start")
  @@map("rpt_fin_settlement")
}

model RptFinSettlementLine {
  id String @map("id") @id @default(uuid())

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  settlementId String @map("settlement_id")
  settlement   RptFinSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  paymentMethod PaymentMethod @map("payment_method")

  systemAmount         Decimal @map("system_amount") @default(0) @db.Decimal(18, 2)
  systemPaymentsCount  Int @map("system_payments_count")     @default(0)
  systemOrdersCount    Int @map("system_orders_count")     @default(0)

  /// What reseller declares for this tender type (most important for CASH)
  declaredAmount Decimal? @map("declared_amount") @db.Decimal(18, 2)
  /// declared - system
  varianceAmount Decimal? @map("variance_amount") @db.Decimal(18, 2)

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  @@unique([settlementId, paymentMethod], map: "uq_rpt_fin_settlement_line__settlement_id__payment_method")
  @@index([orgId, settlementId], map: "idx_rpt_fin_settlement_line__org_id__settlement_id")
  @@index([paymentMethod], map: "idx_rpt_fin_settlement_line__payment_method")
  @@map("rpt_fin_settlement_line")
}

model RptFinAttestation {
  id String @map("id") @id @default(uuid())

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  settlementId String @map("settlement_id")
  settlement   RptFinSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  kind RptFinAttestationKind @map("kind")
  /// Human-readable for audit (STATION, ORGANIZATION, etc.)
  roleName String? @map("role_name")

  actorId   String? @map("actor_id")
  signedAt  DateTime? @map("signed_at")
  note      String? @map("note")
  /// Optional signature of payload at time of signing (store base64/hex; app-defined)
  payloadSig String? @map("payload_sig")

  createdAt DateTime @map("created_at") @default(now())

  @@index([orgId, settlementId], map: "idx_rpt_fin_attestation__org_id__settlement_id")
  @@index([settlementId, kind, signedAt], map: "idx_rpt_fin_attestation__settlement_id__kind__signed_at")
  @@map("rpt_fin_attestation")
}

model RptFinPosting {
  id String @map("id") @id @default(uuid())

  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  settlementId String @map("settlement_id") @unique
  settlement   RptFinSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  kind RptFinPostingKind @map("kind") @default(SETTLEMENT_SNAPSHOT)

  /// Sealed JSON snapshot: lines, totals, tender breakdown, and source coverage pointers
  payload Json @map("payload")
  /// Cheap integrity check for offline verification / support debugging
  payloadHash String @map("payload_hash")

  postedAt  DateTime @map("posted_at") @default(now())
  postedBy  String? @map("posted_by")
  /// When true, operational rows covered by this posting are eligible for purging (policy-driven)
  sealed    Boolean @map("sealed")  @default(true)

  createdAt DateTime @map("created_at") @default(now())

  @@index([orgId, postedAt], map: "idx_rpt_fin_posting__org_id__posted_at")
  @@index([postedAt], map: "idx_rpt_fin_posting__posted_at")
  @@map("rpt_fin_posting")
}

model RptFinSourceCoverage {
  id    String @map("id") @id @default(uuid())
  orgId String @map("org_id")
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Restrict)

  resellerId String @map("reseller_id")
  reseller   Reseller @relation(fields: [resellerId], references: [id], onDelete: Restrict)

  stationId String @map("station_id")
  station   WifiStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  maxCoveredPaidAt DateTime @map("max_covered_paid_at")
  lastPostingId    String? @map("last_posting_id")

  updatedAt DateTime @map("updated_at") @updatedAt
  createdAt DateTime @map("created_at") @default(now())

  @@unique([orgId, resellerId, stationId], map: "uq_rpt_fin_source_coverage__org_id__reseller_id__station_id")
  @@index([orgId, maxCoveredPaidAt], map: "idx_rpt_fin_source_coverage__org_id__max_covered_paid_at")
  @@map("rpt_fin_source_coverage")
}
