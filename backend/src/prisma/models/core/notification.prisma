enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationTag {
  SOCIAL
  POINTS
  SYSTEM
  PROMOTION
  SECURITY
}

enum NotificationScope {
  USER // Normal per-user notification
  GLOBAL // System-wide broadcast
}

// 1
// code : POST_COMMENT
// name : post comment template
// title : {{user}} - {{status}}
// body : {{user}} သည် {{time}} သင့် ပိုစ် {{postTitle}} အား ကွန်မန့် ပေးခဲ့ပါသည်.
// {user: "", time: "", postTitle: ""}
// PUSH
// NORMAL
// true

model NotificationTemplate {
  id Int @id @default(autoincrement()) @map("id")

  code String @unique @map("code") // e.g. TOPUP_SUCCESS
  name String @map("name")

  // Handlebars templates
  titleTemplate String @map("title_template")
  bodyTemplate  String @map("body_template")

  // Optional payload schema reference
  payloadSchema Json? @map("payload_schema")

  defaultChannel NotificationChannel  @map("default_channel")
  priority       NotificationPriority @default(NORMAL) @map("priority")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  notifications Notification[]

  @@map("tbl_notification_template")
}

model Notification {
  id String @id @default(uuid()) @map("id")

  templateId Int                  @map("template_id")
  template   NotificationTemplate @relation(fields: [templateId], references: [id])
  scope      NotificationScope    @default(USER) @map("scope")

  // Who triggered it (optional)
  actorUserId String? @map("actor_user_id")

  // Dynamic data for handlebars
  payload Json @map("payload")

  // Routing
  channel  NotificationChannel  @map("channel")
  priority NotificationPriority @map("priority")
  tag      NotificationTag?     @map("tag") // Optional tag for categorizing notifications

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  recipients NotificationRecipient[]

  @@index([templateId])
  @@index([tag])
  @@map("tbl_notification")
}

model NotificationRecipient {
  id String @id @default(uuid()) @map("id")

  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  // user            TblUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status NotificationStatus @default(PENDING) @map("status")

  // Rendered content snapshot (important!)
  renderedTitle String? @map("rendered_title")
  renderedBody  String? @map("rendered_body")

  readAt       DateTime? @map("read_at")
  sentAt       DateTime? @map("sent_at")
  failedReason String?   @map("failed_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, status])
  @@map("tbl_notification_recipient")
}

model UserNotificationSetting {
  id Int @id @default(autoincrement()) @map("id")

  userId String @map("user_id")
  // user            TblUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel   NotificationChannel @map("channel")
  isEnabled Boolean             @default(true) @map("is_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@unique([userId, channel])
  @@map("tbl_user_notification_setting")
}
