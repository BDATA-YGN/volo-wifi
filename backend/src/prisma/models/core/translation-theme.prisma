model Translation {
  id        Int       @id @default(autoincrement()) @map("id")
  locale    String    @unique @map("locale")
  messages  Json      @map("messages")
  createdAt DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")
  deletedAt DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@map("tbl_translation")
}

model Theme {
  id         String    @id @default(uuid()) @map("id")
  name       String    @map("name")
  lightTheme Json      @map("light_theme")
  darkTheme  Json      @map("dark_theme")
  isDefault  Boolean   @default(false) @map("is_default")
  isActive   Boolean   @default(false) @map("is_active")
  createdAt  DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3) @map("updated_at")
  deletedAt  DateTime? @db.Timestamptz(3) @map("deleted_at")

  @@map("tbl_themes")
}
