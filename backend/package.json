{
  "name": "bdata-admin",
  "version": "4.0.2",
  "description": "BDATA Admin",
  "author": "BDATA",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development node --max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js",
    "build": "npm run prisma:generate && swc src -d dist --source-maps --copy-files",
    "postinstall": "prisma generate",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push && prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "ts-node -r tsconfig-paths/register src/prisma/seed.ts",
    "prisma:seed": "ts-node -r tsconfig-paths/register src/prisma/seed.ts",
    "seed:places": "ts-node -r tsconfig-paths/register ./tools/seed-places.ts",
    "docs": "npx apidoc -c ./apidoc.console.json -o ./src/docs/console -t ./template",
    "db:backup": "ts-node ./tools/pg-backup-restore.ts backup",
    "db:restore": "ts-node ./tools/pg-backup-restore.ts restore",
    "db:clone": "ts-node ./tools/pg-backup-restore.ts clone",
    "data:menu:backup": "ts-node -r tsconfig-paths/register ./tools/menu-backup-restore.ts backup",
    "data:menu:restore": "ts-node -r tsconfig-paths/register ./tools/menu-backup-restore.ts restore",
    "data:roles:backup": "ts-node -r tsconfig-paths/register ./tools/role-settings-backup-restore.ts backup",
    "data:roles:restore": "ts-node -r tsconfig-paths/register ./tools/role-settings-backup-restore.ts restore",
    "data:i18n:backup": "ts-node -r tsconfig-paths/register ./tools/translation-theme-backup-restore.ts backup",
    "data:i18n:restore": "ts-node -r tsconfig-paths/register ./tools/translation-theme-backup-restore.ts restore",
    "data:backfill:role-kind": "ts-node -r tsconfig-paths/register ./tools/backfill-mng-role-setting-kind.ts",
    "data:wifi:migrate:dry": "ts-node -r tsconfig-paths/register ./tools/migrate-from-volo-api-console.ts -- --dry-run",
    "data:wifi:migrate": "ts-node -r tsconfig-paths/register ./tools/migrate-from-volo-api-console.ts",
    "data:wifi:migrate:phase1": "ts-node -r tsconfig-paths/register ./tools/migrate-from-volo-api-console.ts -- --phase=1",
    "data:wifi:migrate:phase2": "ts-node -r tsconfig-paths/register ./tools/migrate-from-volo-api-console.ts -- --phase=2",
    "data:wifi:migrate:phase3": "ts-node -r tsconfig-paths/register ./tools/migrate-from-volo-api-console.ts -- --phase=3",
    "data:wifi:migrate:reset": "ts-node -r tsconfig-paths/register ./tools/reset-wifi-migration.ts",
    "data:retail-pricing:backup": "ts-node -r tsconfig-paths/register ./tools/consolidate-retail-pricing.ts -- --mode=backup",
    "data:retail-pricing:consolidate": "ts-node -r tsconfig-paths/register ./tools/consolidate-retail-pricing.ts -- --mode=consolidate",
    "data:radius:seed-vendors": "ts-node -r tsconfig-paths/register ./tools/seed-radius-vendor-profiles.ts",
    "data:radius:seed-plan-policies": "ts-node -r tsconfig-paths/register ./tools/seed-radius-plan-policies.ts",
    "data:radius:seed-profiles": "ts-node -r tsconfig-paths/register ./tools/seed-org-radius-profiles.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "1.15.2",
    "bcrypt": "^6.0.0",
    "canvas": "^3.2.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "envalid": "^7.3.1",
    "express": "^4.18.1",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^5.1.1",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.0",
    "joi": "^17.13.3",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.2",
    "lz-string": "^1.5.0",
    "md5": "^2.3.0",
    "mime-types": "^3.0.2",
    "minio": "^8.0.6",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "prisma-paginate": "^5.2.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "typedi": "^0.10.0",
    "uuid": "^13.0.0",
    "winston": "^3.8.1",
    "winston-daily-rotate-file": "^4.7.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.2.220",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.1",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/hpp": "^0.2.2",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/md5": "^2.3.6",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.1",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.20.0",
    "nodemon": "^2.0.19",
    "pm2": "^5.2.0",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.7.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
